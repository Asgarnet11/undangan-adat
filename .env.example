# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# ==============================================================================
# Salin file ini menjadi .env atau .env.local untuk konfigurasi lokal.
# Di dashboard Vercel, masukkan variabel ini di menu: Settings > Environment Variables.
# ==============================================================================

# URL domain aplikasi di produksi (tanpa trailing slash)
# Digunakan untuk pembentukan tautan Open Graph dan tautan WhatsApp
VITE_APP_URL=https://undangan-adat.vercel.app

# Nama brand dan kontak WhatsApp admin (ditampilkan pada landing page netral produksi)
VITE_BRAND_NAME="Kalyana Undangan Adat"
VITE_WHATSAPP_NUMBER=6281234567890
